{
  "name": "code-canvas",
  "private": true,
  "version": "0.3.1",
  "description": "Code Canvas",
  "scripts": {
    "build": "npm -w webview run build && npm -w extension run build",
    "watch": "npm -w webview run dev & npm -w extension run watch",
    "package": "npm -w extension run package",
    "test": "npm -w webview run test",
    "typecheck": "tsc --noEmit -p extension/tsconfig.json && tsc --noEmit -p webview/tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "snapshot": "node tools/snapshot.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "commonjs",
  "workspaces": [
    "webview",
    "extension"
  ],
  "overrides": {},
  "devDependencies": {
    "playwright": "1.65.1"
  }
}
